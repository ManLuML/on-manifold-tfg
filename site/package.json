{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets": "node scripts/process-assets.mjs && node scripts/asset-integrity.mjs --record",
    "check:assets": "node scripts/asset-integrity.mjs",
    "dev": "astro dev",
    "check": "astro check && npm run check:assets && vitest run",
    "build": "npm run check && astro build && node scripts/verify-dist.mjs",
    "check:links": "node scripts/check-external-links.mjs",
    "check:production": "node scripts/check-production.mjs",
    "test:e2e": "playwright test",
    "test": "npm run build && npm run check:links && npm run test:e2e",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.2.10"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
