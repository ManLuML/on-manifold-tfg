---
const base = import.meta.env.BASE_URL;
---

<div class="amplification-explorer" data-amplification-explorer>
  <div class="control-panel">
    <div class="control-heading">
      <div>
        <p class="interaction-label">Interactive explainer</p>
        <h3>Move from clean data toward high noise.</h3>
      </div>
      <output for="noise-time" data-time-output aria-live="polite">t = 0.25</output>
    </div>
    <label for="noise-time">Flow-matching time <span>(0 = noise, 1 = clean)</span></label>
    <input
      id="noise-time"
      data-time-slider
      type="range"
      min="0.02"
      max="1"
      step="0.01"
      value="0.25"
      aria-describedby="time-help coefficient-summary"
    />
    <div class="range-labels" aria-hidden="true"><span>High noise</span><span>Clean data</span></div>
    <p id="time-help">Use arrow keys for fine steps, Page Up or Page Down for larger changes, and Home or End for the boundaries.</p>
  </div>

  <div class="coefficient-grid" id="coefficient-summary">
    <article class="coefficient x">
      <p class="symbol">x</p>
      <div class="formula-visual" aria-hidden="true"><span class="norm">‖</span><span>x̂<sup>(x)</sup> − x</span><span class="norm">‖</span><span>= δ<sub>x</sub></span></div>
      <math class="sr-math"><mrow><mo>‖</mo><msup><mover><mi>x</mi><mo>^</mo></mover><mrow><mo>(</mo><mi>x</mi><mo>)</mo></mrow></msup><mo>−</mo><mi>x</mi><mo>‖</mo><mo>=</mo><msub><mi>δ</mi><mi>x</mi></msub></mrow></math>
      <p class="value"><span data-x-value>1.00</span>× error</p>
      <p>No recovery amplification.</p>
    </article>
    <article class="coefficient v">
      <p class="symbol">v</p>
      <div class="formula-visual" aria-hidden="true"><span class="norm">‖</span><span>x̂<sup>(v)</sup> − x</span><span class="norm">‖</span><span>= (1 − t)δ<sub>v</sub></span></div>
      <math class="sr-math"><mrow><mo>‖</mo><msup><mover><mi>x</mi><mo>^</mo></mover><mrow><mo>(</mo><mi>v</mi><mo>)</mo></mrow></msup><mo>−</mo><mi>x</mi><mo>‖</mo><mo>=</mo><mo>(</mo><mn>1</mn><mo>−</mo><mi>t</mi><mo>)</mo><msub><mi>δ</mi><mi>v</mi></msub></mrow></math>
      <p class="value"><span data-v-value>0.75</span>× error</p>
      <p>Bounded by one.</p>
    </article>
    <article class="coefficient epsilon">
      <p class="symbol">ε</p>
      <div class="formula-visual" aria-hidden="true"><span class="norm">‖</span><span>x̂<sup>(ε)</sup> − x</span><span class="norm">‖</span><span>=</span><span class="fraction"><span>1 − t</span><span>t</span></span><span>δ<sub>ε</sub></span></div>
      <math class="sr-math"><mrow><mo>‖</mo><msup><mover><mi>x</mi><mo>^</mo></mover><mrow><mo>(</mo><mi>ε</mi><mo>)</mo></mrow></msup><mo>−</mo><mi>x</mi><mo>‖</mo><mo>=</mo><mfrac><mrow><mn>1</mn><mo>−</mo><mi>t</mi></mrow><mi>t</mi></mfrac><msub><mi>δ</mi><mi>ε</mi></msub></mrow></math>
      <p class="value"><span data-epsilon-value>3.00</span>× error</p>
      <p>Diverges as t approaches zero.</p>
    </article>
  </div>

  <figure class="paper-manifold-figure">
    <picture>
      <source type="image/avif" srcset={`${base}media/figures/figure-1a-720.avif 720w, ${base}media/figures/figure-1a-960.avif 960w`} sizes="(max-width: 760px) calc(100vw - 2rem), 36rem" />
      <source type="image/webp" srcset={`${base}media/figures/figure-1a-720.webp 720w, ${base}media/figures/figure-1a-960.webp 960w`} sizes="(max-width: 760px) calc(100vw - 2rem), 36rem" />
      <img src={`${base}media/figures/figure-1a-960.png`} srcset={`${base}media/figures/figure-1a-720.png 720w, ${base}media/figures/figure-1a-960.png 960w`} sizes="(max-width: 760px) calc(100vw - 2rem), 36rem" width="960" height="1068" loading="lazy" decoding="async" alt="Paper Figure 1(a): x-prediction follows the data manifold from a noisy state toward the target region, while v- and epsilon-prediction can depart from the manifold" />
    </picture>
    <figcaption>Camera-ready Figure 1(a). Without guidance, denoising returns toward the source-class region. Under TFG, x-prediction follows the data manifold toward the target region, while indirect recovery can move off-manifold.</figcaption>
  </figure>

  <p class="convention"><strong>High-noise convention:</strong> this paper uses <math><mrow><msub><mi>z</mi><mi>t</mi></msub><mo>=</mo><mi>t</mi><mi>x</mi><mo>+</mo><mo>(</mo><mn>1</mn><mo>−</mo><mi>t</mi><mo>)</mo><mi>ε</mi></mrow></math>, so <math><mrow><mi>t</mi><mo>→</mo><mn>0</mn></mrow></math> means approaching pure noise.</p>

  <div class="static-table">
    <h4>Static coefficient table</h4>
    <div class="table-scroll" tabindex="0" aria-label="Recovery-error coefficient table, horizontally scrollable">
      <table>
        <caption>Recovery-error multiplier before each target’s base error</caption>
        <thead><tr><th scope="col">t</th><th scope="col">Noise level</th><th scope="col">x</th><th scope="col">v: 1−t</th><th scope="col">ε: (1−t)/t</th></tr></thead>
        <tbody>
          <tr><th scope="row">0.80</th><td>Low</td><td>1.00</td><td>0.20</td><td>0.25</td></tr>
          <tr><th scope="row">0.50</th><td>Middle</td><td>1.00</td><td>0.50</td><td>1.00</td></tr>
          <tr><th scope="row">0.20</th><td>High</td><td>1.00</td><td>0.80</td><td>4.00</td></tr>
          <tr><th scope="row">0.05</th><td>Very high</td><td>1.00</td><td>0.95</td><td>19.00</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  const explorers = document.querySelectorAll<HTMLElement>('[data-amplification-explorer]');

  for (const explorer of explorers) {
    const slider = explorer.querySelector<HTMLInputElement>('[data-time-slider]');
    const timeOutput = explorer.querySelector<HTMLOutputElement>('[data-time-output]');
    const xValue = explorer.querySelector<HTMLElement>('[data-x-value]');
    const vValue = explorer.querySelector<HTMLElement>('[data-v-value]');
    const epsilonValue = explorer.querySelector<HTMLElement>('[data-epsilon-value]');
    if (!slider || !timeOutput || !xValue || !vValue || !epsilonValue) continue;

    const update = () => {
      const t = Number(slider.value);
      const v = 1 - t;
      const epsilon = (1 - t) / t;
      timeOutput.value = `t = ${t.toFixed(2)}`;
      xValue.textContent = '1.00';
      vValue.textContent = v.toFixed(2);
      epsilonValue.textContent = epsilon > 99 ? '>99' : epsilon.toFixed(2);
      slider.setAttribute('aria-valuetext', `t ${t.toFixed(2)}; x multiplier 1; v multiplier ${v.toFixed(2)}; epsilon multiplier ${epsilon.toFixed(2)}`);
    };

    slider.addEventListener('input', update);
    update();
  }
</script>

<style>
  .amplification-explorer { margin-top: 2rem; }
  .control-panel { padding: 1.25rem 0; border-block: 1px solid var(--line); background: transparent; }
  .control-heading { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
  .interaction-label { margin: 0; color: var(--navy); font-size: 0.72rem; font-weight: 850; letter-spacing: 0.14em; text-transform: uppercase; }
  h3 { margin: 0.25rem 0 1rem; font-size: clamp(1.45rem, 3vw, 2.2rem); letter-spacing: -0.035em; }
  output { flex: none; padding: 0.25rem 0; border-bottom: 2px solid var(--navy); color: var(--navy-dark); font-weight: 780; font-variant-numeric: tabular-nums; }
  label { display: block; color: var(--slate); font-weight: 750; }
  label span { font-weight: 500; }
  input[type='range'] { width: 100%; min-height: 2.75rem; margin: 0.5rem 0 0; accent-color: var(--navy); cursor: pointer; }
  .range-labels { display: flex; justify-content: space-between; color: var(--muted); font-size: 0.75rem; }
  #time-help { margin: 0.7rem 0 0; color: var(--muted); font-size: 0.78rem; }
  .coefficient-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin: 1.5rem 0; }
  .coefficient { padding: 1rem 0 0; border: 0; border-top: 2px solid var(--navy); border-radius: 0; background: transparent; }
  .coefficient.v { border-top-color: var(--cyan-dark); }
  .coefficient.epsilon { border-top-color: var(--error); background: transparent; }
  .symbol { margin: 0; font-size: 1.7rem; font-weight: 700; line-height: 1; }
  .formula-visual { display: flex; min-height: 3.3rem; align-items: center; flex-wrap: wrap; gap: 0.12em; color: #263b5c; font-family: 'Inter Variable', system-ui, sans-serif; font-size: clamp(1.2rem, 2vw, 1.65rem); line-height: 1.25; }
  .formula-visual sup, .formula-visual sub { font-size: 0.64em; }
  .norm { font-size: 1.3em; font-weight: 400; }
  .fraction { display: inline-grid; grid-template-rows: auto auto; min-width: 2.3em; align-items: center; margin-inline: 0.1em; text-align: center; line-height: 1; }
  .fraction span:first-child { padding: 0 0.14em 0.08em; border-bottom: 1.5px solid currentColor; }
  .fraction span:last-child { padding-top: 0.08em; }
  .sr-math { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .value { margin: 0.6rem 0 0; font-size: 1.3rem; font-weight: 850; font-variant-numeric: tabular-nums; }
  .coefficient > p:last-child { margin-bottom: 0; color: var(--muted); font-size: 0.82rem; }
  .paper-manifold-figure { width: min(36rem, 100%); margin: 2rem auto 0; }
  .paper-manifold-figure picture { display: block; background: white; }
  .paper-manifold-figure img { width: 100%; }
  .paper-manifold-figure figcaption { margin-top: 0.85rem; color: var(--slate); font-size: 0.86rem; line-height: 1.55; }
  .convention { padding: 1rem 0 0; border-top: 1px solid var(--line); background: transparent; color: var(--slate); }
  .static-table { margin-top: 1.5rem; }
  h4 { margin: 0 0 0.7rem; font-size: 1rem; }
  .table-scroll { overflow-x: auto; border-block: 1px solid var(--line); border-radius: 0; background: transparent; }
  table { width: 100%; min-width: 38rem; border-collapse: collapse; }
  caption { padding: 0.8rem; color: var(--slate); font-size: 0.82rem; text-align: left; }
  th, td { padding: 0.7rem 0.8rem; border-top: 1px solid var(--line); text-align: right; font-variant-numeric: tabular-nums; }
  th:first-child, td:first-child, th:nth-child(2), td:nth-child(2) { text-align: left; }
  thead th { color: var(--slate); font-size: 0.78rem; }

  @media (max-width: 760px) {
    .coefficient-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .control-heading { display: block; }
    output { display: inline-block; margin-bottom: 0.8rem; }
  }
</style>
