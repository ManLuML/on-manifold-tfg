---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Page not found — On-Manifold TFG"
  description="The requested On-Manifold TFG page could not be found."
  canonical="https://manluml.github.io/on-manifold-tfg/404.html"
  noindex
>
  <main id="main-content" class="not-found">
    <a class="brand" href="https://manluml.github.io/"><img src={`${base}brand/manluml-mascot.svg`} width="76" height="76" alt="" />ManLuML</a>
    <p class="code">404</p>
    <h1>This path left the manifold.</h1>
    <p>The research page and all of its evidence are still available.</p>
    <a class="return" href={base}>Return to On-Manifold TFG</a>
  </main>
</BaseLayout>

<style>
  .not-found { display: grid; min-height: 100svh; place-content: center; justify-items: center; padding: 2rem; text-align: center; }
  .brand { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--ink); font-weight: 850; text-decoration: none; }
  .brand img { width: 4rem; height: 4rem; }
  .code { margin: 2rem 0 0; color: var(--error); font-weight: 900; letter-spacing: 0.18em; }
  h1 { max-width: 13ch; margin: 0.4rem 0; font-size: clamp(2.7rem, 8vw, 5rem); font-weight: 640; line-height: 1; letter-spacing: -0.05em; }
  .not-found > p:not(.code) { color: var(--slate); }
  .return { margin-top: 1rem; padding: 0.75rem 1rem; border-radius: 999px; background: var(--navy); color: white; font-weight: 780; text-decoration: none; }
</style>
