---
import { getEntry } from 'astro:content';
import ResponsiveFigure from '../components/ResponsiveFigure.astro';
import AmplificationExplorer from '../components/interactive/AmplificationExplorer.astro';
import ResultExplorer from '../components/interactive/ResultExplorer.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('projects', 'on-manifold-tfg');
if (!entry) throw new Error('Project content is missing.');

const project = entry.data;
const base = import.meta.env.BASE_URL;
const pageTitle = `${project.title} — ECCV 2026`;
const pageDescription = 'Prediction target determines whether training-free guidance fails gracefully or catastrophically. Explore the equations, controls, results, resources, and limitations.';
---

<BaseLayout title={pageTitle} description={pageDescription} abstract={project.abstract}>
  <header class="site-header">
    <a class="manluml-link" href="https://manluml.github.io/" aria-label="Return to ManLuML home">
      <img src={`${base}brand/manluml-mascot.svg`} width="36" height="36" alt="" />
      <span>ManLuML</span>
    </a>
    <nav aria-label="Project navigation">
      <a href="#abstract">Thesis</a>
      <a href="#resources">Resources</a>
    </nav>
  </header>

  <main id="main-content">
    <header class="project-hero" id="top">
      <div class="hero-copy">
        <p class="venue">{project.venue}</p>
        <h1>{project.title}</h1>

        <p class="authors">
          {project.authors.map((author, index) => (
            <>
              {index > 0 && <span aria-hidden="true"> · </span>}
              <a href={author.profileUrl}>{author.name}</a><sup>{author.marker}</sup>
            </>
          ))}
        </p>

        <ol class="affiliations" aria-label="Author affiliations">
          {project.authors.map((author, index) => (
            <li><sup>{index + 1}</sup> {author.affiliation}</li>
          ))}
        </ol>

        <p class="contribution-legend"><span>* Equal contribution</span><span>† Corresponding author</span></p>
        <p class="author-contact">
          <a href={`mailto:${project.authors[0].email}`}>{project.authors[0].email}</a>
          <span aria-hidden="true"> · </span>
          <a href={`mailto:${project.authors[1].email}`}>{project.authors[1].email}</a>
        </p>

        <nav class="resource-actions" aria-label="Primary project resources">
          <a class="primary" href={project.links.paper}>Paper <span aria-hidden="true">↗</span></a>
          <a href={project.links.code}>Code <span aria-hidden="true">↗</span></a>
          <a href="#resources">Data <span aria-hidden="true">↓</span></a>
          <a href="#bibtex">Cite <span aria-hidden="true">↓</span></a>
        </nav>
      </div>

      <aside class="hero-thesis" aria-label="Headline result">
        <p class="thesis-label">TFG robustness ranking</p>
        <ol class="robustness-ranking" aria-label="Prediction targets ranked from most to least robust for training-free guidance">
          <li class="x"><span>1</span><strong>x-prediction</strong><em>most robust</em></li>
          <li class="v"><span>2</span><strong>v-prediction</strong></li>
          <li class="epsilon"><span>3</span><strong>ε-prediction</strong><em>least robust</em></li>
        </ol>
        <p>Direct clean-image prediction keeps recovery stable. Noise prediction can amplify small errors without bound at the earliest, noisiest steps.</p>
        <dl>
          <div><dt>x at D=512</dt><dd>93.3%</dd></div>
          <div><dt>v at D=512</dt><dd>21.5%</dd></div>
          <div><dt>ε at D=512</dt><dd>0.5%</dd></div>
        </dl>
        <p class="metric-note">On-manifold rate in the fully controlled crossed-lines experiment.</p>
      </aside>
    </header>

    <section class="thesis-section" id="abstract" aria-labelledby="thesis-heading">
      <div class="section-intro">
        <p class="kicker">The thirty-second thesis</p>
        <h2 id="thesis-heading">The target decides how failure looks.</h2>
        <p class="thesis-lede">Training-free guidance acts through an estimate of the clean image. When that estimate is direct, a miss can stay realistic. When recovery divides error by a nearly zero time value, a miss can become an off-manifold collapse.</p>
      </div>

      <div class="target-summary" aria-label="Prediction target summary">
        <article class="target-card x-card">
          <p class="target-symbol">x</p>
          <h3>No recovery amplification</h3>
          <p>The model predicts the clean image directly. Guidance can miss the requested class while the image remains plausible.</p>
        </article>
        <article class="target-card v-card">
          <p class="target-symbol">v</p>
          <h3>Bounded amplification</h3>
          <p>Recovery error is scaled by <math><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mi>t</mi><mo>)</mo></mrow></math>, so the coefficient stays bounded.</p>
        </article>
        <article class="target-card epsilon-card">
          <p class="target-symbol">ε</p>
          <h3>Unbounded at high noise</h3>
          <p>The coefficient <math><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mi>t</mi><mo>)</mo><mo>/</mo><mi>t</mi></mrow></math> diverges as <math><mrow><mi>t</mi><mo>→</mo><mn>0</mn></mrow></math>.</p>
        </article>
      </div>

      <figure class="teaser-figure">
        <picture>
          <source type="image/avif" srcset={`${base}media/figures/teaser-720.avif 720w, ${base}media/figures/teaser-1200.avif 1200w, ${base}media/figures/teaser-1800.avif 1800w`} sizes="(max-width: 760px) calc(100vw - 2rem), 1120px" />
          <source type="image/webp" srcset={`${base}media/figures/teaser-720.webp 720w, ${base}media/figures/teaser-1200.webp 1200w, ${base}media/figures/teaser-1800.webp 1800w`} sizes="(max-width: 760px) calc(100vw - 2rem), 1120px" />
          <img
            src={`${base}media/figures/teaser-1200.png`}
            srcset={`${base}media/figures/teaser-720.png 720w, ${base}media/figures/teaser-1200.png 1200w, ${base}media/figures/teaser-1800.png 1800w`}
            sizes="(max-width: 760px) calc(100vw - 2rem), 1120px"
            width="1200"
            height="458"
            loading="eager"
            decoding="async"
            alt="Diagram and examples showing x-prediction moving along the data manifold, epsilon-prediction collapsing off it, and v-prediction failing more gracefully"
          />
        </picture>
        <figcaption>Guidance can succeed, fail gracefully while staying realistic, or fail catastrophically by leaving the data manifold. The paper traces that difference to prediction target.</figcaption>
      </figure>
    </section>

    <section class="content-section failure-section" id="results" aria-labelledby="failure-heading">
      <div class="section-intro">
        <p class="kicker">01 · The visible failure</p>
        <h2 id="failure-heading">A wrong bird can still look like a bird.</h2>
        <p class="thesis-lede">Validity asks whether a classifier accepts the target. It does not ask whether the image remains realistic. The distinction becomes obvious at stronger guidance: a graceful miss preserves coherent structure; a catastrophic miss becomes an artifact that merely excites the classifier.</p>
      </div>
      <ResultExplorer />
    </section>

    <section class="content-section method-section" id="method" aria-labelledby="method-heading">
      <div class="section-intro">
        <p class="kicker">02 · Why the target matters</p>
        <h2 id="method-heading">The same model error can arrive with a very different multiplier.</h2>
        <p class="thesis-lede">In the paper’s flow-matching convention, <math><mrow><msub><mi>z</mi><mi>t</mi></msub><mo>=</mo><mi>t</mi><mi>x</mi><mo>+</mo><mo>(</mo><mn>1</mn><mo>−</mo><mi>t</mi><mo>)</mo><mi>ε</mi></mrow></math>. All three targets can recover a clean image estimate, but only ε-recovery divides by t.</p>
      </div>
      <AmplificationExplorer />
      <p class="technical-note"><strong>Read the ranking at the right level.</strong> The exact recovery coefficients are shown above; the paper’s overall robustness ordering—x first, v second, ε third—also reflects the targets’ different base errors, not a claim that the three displayed coefficients alone have one strict order at every t.</p>
    </section>

    <section class="content-section controlled-section" aria-labelledby="controlled-heading">
      <div class="section-intro">
        <p class="kicker">03 · Controlled evidence first</p>
        <h2 id="controlled-heading">Hold the model fixed. Change the target.</h2>
        <p class="thesis-lede">The crossed-lines study is the clean attribution test: identical residual MLPs, identical data, identical training budget, identical guidance, and only the prediction objective changed. As ambient dimension rises, the gap opens sharply.</p>
      </div>

      <div class="controlled-grid">
        <ResponsiveFigure
          slug="crossed-lines-grid"
          widths={[720, 1400]}
          fallback="png"
          width={1400}
          height={1768}
          alt="Five rows of crossed-lines results from dimension 2 through 512; x-prediction stays concentrated on the target line while v-prediction spreads and epsilon-prediction largely leaves the line at high dimension"
          caption="Crossed-lines under DPS guidance with strength 10 and 100 Euler steps. Each target uses the same 256-hidden, five-block residual MLP design; the D=512 row makes the robustness ordering unmistakable."
        />

        <div class="controlled-copy">
          <div class="headline-table table-scroll" tabindex="0" aria-label="D equals 512 on-manifold results, horizontally scrollable">
            <table>
              <caption>On-manifold rate at D = 512</caption>
              <thead><tr><th scope="col">Prediction target</th><th scope="col">Rate</th><th scope="col">Failure character</th></tr></thead>
              <tbody>
                <tr><th scope="row">x</th><td class="best">93.3%</td><td>Structure preserved</td></tr>
                <tr><th scope="row">v</th><td>21.5%</td><td>Bounded but degraded</td></tr>
                <tr><th scope="row">ε</th><td class="worst">0.5%</td><td>Near-total collapse</td></tr>
              </tbody>
            </table>
          </div>

          <div class="control-lines" aria-label="Converging controls">
            <article>
              <p class="control-number">1</p>
              <div><h3>Fully controlled toy study</h3><p>Three identical networks on crossed lines isolate the prediction objective across D ∈ &#123;2, 8, 32, 128, 512&#125;.</p></div>
            </article>
            <article>
              <p class="control-number">2</p>
              <div><h3>Closer latent-space pair</h3><p>DiT and SiT keep architecture family, scale, training data, and operating space much closer than the full pretrained comparison; their ordering is consistent with the target effect.</p></div>
            </article>
            <article>
              <p class="control-number">3</p>
              <div><h3>Capacity reversed</h3><p>JiT-B has 131M diffusion parameters yet reaches C-FID 31.3, ahead of 675M-parameter DiT at 36.7 and SiT at 34.4.</p></div>
            </article>
            <article>
              <p class="control-number">4</p>
              <div><h3>Within pixel space</h3><p>JiT and PixelFlow both avoid a latent VAE, providing a complementary operating-space control.</p></div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <section class="content-section real-image-section" aria-labelledby="real-heading">
      <div class="section-intro">
        <p class="kicker">04 · Real-image evidence</p>
        <h2 id="real-heading">Classifier validity can hide manifold damage.</h2>
        <p class="thesis-lede"><strong>Child FID</strong> compares guided samples with the requested fine-grained species, rather than with the broad parent distribution. It exposes samples that a classifier accepts even though their appearance has drifted away from realistic images of that species.</p>
      </div>

      <div class="metric-callouts" aria-label="Matched validity Child FID results">
        <article class="x"><p>x · JiT-H</p><strong>32.9</strong><span>Child FID</span></article>
        <article class="v"><p>v · SiT</p><strong>34.7</strong><span>Child FID</span></article>
        <article class="epsilon"><p>ε · DiT</p><strong>38.1</strong><span>Child FID</span></article>
        <article class="gap"><p>x → ε gap</p><strong>5.2</strong><span>points at matched validity</span></article>
      </div>

      <p class="sample-scale"><strong>Benchmark scale:</strong> 143 bird species nested under 30 ImageNet parents; every plotted point contains 9,152 generated images (64 per species). The matched operating points are all near 26.6% validity.</p>

      <div class="plot-grid">
        <ResponsiveFigure
          slug="rho-fid-vs-validity"
          widths={[720, 1200]}
          fallback="png"
          width={1200}
          height={867}
          alt="Plot of parent FID against classifier validity; several models reach similar validity while their parent FID trade-offs differ"
          caption="Validity records whether the evaluation classifier predicts the requested species. Similar validity does not imply similar visual fidelity."
        />
        <ResponsiveFigure
          slug="rho-fid-vs-child-fid"
          widths={[720, 1200]}
          fallback="png"
          width={1200}
          height={867}
          alt="Plot of parent FID against Child FID; JiT x-prediction traces the lowest Child FID frontier, SiT v-prediction is intermediate, and DiT epsilon-prediction remains higher"
          caption="Child FID reveals the quality gap at matched validity: 32.85 for JiT-H, 34.66 for SiT, and 38.11 for DiT. Lower is better."
        />
      </div>

      <div class="matched-table table-scroll" tabindex="0" aria-label="Matched validity results, horizontally scrollable">
        <table>
          <caption>Matched-validity operating points from the camera-ready paper</caption>
          <thead><tr><th scope="col">Model</th><th scope="col">Target</th><th scope="col">Guidance ρ</th><th scope="col">Validity</th><th scope="col">P-FID</th><th scope="col">C-FID</th></tr></thead>
          <tbody>
            <tr><th scope="row">JiT-H/16</th><td>x</td><td>3.0</td><td>26.60%</td><td>6.91</td><td class="best">32.85</td></tr>
            <tr><th scope="row">SiT-XL/2</th><td>v</td><td>1.0</td><td>26.64%</td><td>8.21</td><td>34.66</td></tr>
            <tr><th scope="row">DiT-XL/2</th><td>ε</td><td>0.1</td><td>26.69%</td><td>6.70</td><td class="worst">38.11</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="content-section broader-section" aria-labelledby="broader-heading">
      <div class="section-intro">
        <p class="kicker">05 · Broader validation</p>
        <h2 id="broader-heading">Does the ordering persist?</h2>
        <p class="thesis-lede">Across guidance rules, domains, and metrics, the evidence points in the same direction—with qualifications where separation is weaker.</p>
      </div>

      <div class="validation-grid">
        <article class="validation-card">
          <ResponsiveFigure slug="lgd" widths={[640, 960]} fallback="png" width={960} height={693} alt="LGD bird benchmark frontier with JiT-H x-prediction attaining the lowest Child FID" caption="LGD on the fine-grained bird benchmark." />
          <h3>LGD</h3><p class="answer">Yes. JiT-H retains the lowest C-FID frontier.</p><a href={project.links.paper}>Paper details ↗</a>
        </article>
        <article class="validation-card">
          <ResponsiveFigure slug="freedom" widths={[640, 960]} fallback="png" width={960} height={694} alt="FreeDoM bird benchmark frontier with JiT-H x-prediction attaining the lowest Child FID" caption="FreeDoM on the fine-grained bird benchmark." />
          <h3>FreeDoM</h3><p class="answer">Yes. The DPS ordering persists under a second guidance family.</p><a href={project.links.paper}>Paper details ↗</a>
        </article>
        <article class="validation-card">
          <ResponsiveFigure slug="butterfly" widths={[640, 960]} fallback="png" width={960} height={696} alt="Butterfly benchmark P-FID versus Child FID plot, with JiT-H x-prediction on the lowest frontier" caption="Thirty-four butterfly species under six ImageNet parents." />
          <h3>Butterfly benchmark</h3><p class="answer">Yes. The robustness ordering carries to a second fine-grained domain.</p><a href={project.links.datasets[1].url}>Butterfly data ↗</a>
        </article>
        <article class="validation-card">
          <ResponsiveFigure slug="style" widths={[640, 960]} fallback="png" width={960} height={693} alt="Style-transfer plot of Gram loss against content validity; x-prediction retains content accuracy more strongly at high guidance" caption="Four WikiArt styles by 100 ImageNet classes, 400 images per setting." />
          <h3>Style transfer</h3><p class="answer">Broadly yes, but the models separate less sharply than on birds. At ρ=10, JiT-H retains 80% content accuracy while DiT falls to 1.5%.</p><a href={project.links.paper}>Paper details ↗</a>
        </article>
        <article class="validation-card">
          <ResponsiveFigure slug="precision-recall" widths={[640, 960]} fallback="png" width={960} height={675} alt="Precision versus recall plot; JiT-H reaches recall 0.59 while DiT remains near 0.49 and loses precision under stronger guidance" caption="PRDC separates fidelity from coverage and exposes mode-collapse behavior." />
          <h3>Precision and recall</h3><p class="answer">Yes. JiT-H reaches 0.59 recall; DiT peaks at 0.24 precision but remains around 0.49 recall and loses precision as guidance strengthens.</p><a href={project.links.paper}>Paper details ↗</a>
        </article>
        <article class="validation-card inverse-card">
          <div class="inverse-table table-scroll" tabindex="0" aria-label="Inverse problem LPIPS results, horizontally scrollable">
            <table>
              <caption>Best x-prediction perceptual results</caption>
              <thead><tr><th scope="col">Task</th><th scope="col">Best LPIPS</th><th scope="col">ρ</th></tr></thead>
              <tbody><tr><th scope="row">Gaussian deblur</th><td>0.2140</td><td>16</td></tr><tr><th scope="row">4× super-resolution</th><td>0.1886</td><td>24</td></tr></tbody>
            </table>
          </div>
          <h3>Inverse problems</h3><p class="answer">The wider stability range persists in LPIPS. No model beats the degraded-input PSNR baseline, so the claim is perceptual rather than a universal reconstruction win.</p><a href={project.links.code}>Reproduction code ↗</a>
        </article>
      </div>
    </section>

    <section class="content-section limitations-section" aria-labelledby="limitations-heading">
      <div class="section-intro">
        <p class="kicker">06 · Scope and limitations</p>
        <h2 id="limitations-heading">Converging evidence is not a perfect six-model ablation.</h2>
        <p class="thesis-lede">The controlled crossed-lines experiment isolates prediction target. The pretrained real-image comparisons do not: models also vary in architecture, operating space, capacity, and native sampler. The closer pairwise controls and capacity reversal strengthen attribution without erasing those differences.</p>
      </div>
      <div class="limitations-grid">
        <article><h3>What is controlled</h3><p>Crossed lines holds architecture, data, optimization, guidance, and sampling fixed while changing the training target. DiT/SiT and JiT/PixelFlow provide closer pairwise controls in latent and pixel spaces.</p></article>
        <article><h3>Theoretical assumptions</h3><p>The analysis assumes Lipschitz energy functions, well-trained predictors, and comparable order-one Jacobian norms where asymptotic target comparisons use them.</p></article>
        <article><h3>Guidance family</h3><p>The mechanism applies to gradient-based methods that differentiate through the clean estimate, including DPS, LGD, TFG, FreeDoM, and Flow Guidance. Attention-only guidance is outside scope.</p></article>
        <article><h3>Resolution and tasks</h3><p>All reported image experiments use 256×256 generation. Higher-resolution scaling is untested; style-transfer separation is weaker, and inverse-problem PSNR remains below the simple degraded-input baselines.</p></article>
      </div>
    </section>

    <section class="content-section resources-section" id="resources" aria-labelledby="resources-heading">
      <div class="section-intro">
        <p class="kicker">07 · Resources and citation</p>
        <h2 id="resources-heading">Follow every claim back to its source.</h2>
      </div>

      <div class="resources-grid">
        <article><p class="resource-type">Paper</p><h3>arXiv preprint</h3><p>Read the public preprint. Site claims and qualifications are reviewed against the accepted camera-ready source commit.</p><a href={project.links.paper}>Open the PDF ↗</a><a href={project.links.paperAbstract}>View the arXiv record ↗</a></article>
        <article><p class="resource-type">Code</p><h3>Evaluation and inference</h3><p>Reproduce the crossed-lines study, bird benchmark, and inverse-problem evaluations.</p><a href={project.links.code}>Open the repository ↗</a></article>
        <article class="datasets"><p class="resource-type">Data</p><h3>Published benchmark resources</h3><ul>{project.links.datasets.map((dataset) => <li><a href={dataset.url}>{dataset.label} ↗</a></li>)}</ul></article>
      </div>

      <div class="citation-card" id="bibtex">
        <div>
          <p class="resource-type">Cite</p>
          <h3>BibTeX</h3>
        </div>
        <button type="button" data-copy-bibtex aria-describedby="copy-status">Copy BibTeX</button>
        <pre id="bibtex-text" tabindex="0" aria-label="BibTeX citation, horizontally scrollable"><code>@inproceedings&#123;lee2026onmanifold,
  title     = &#123;Not All Prediction Targets Keep Training-Free Diffusion Guidance on the Manifold&#125;,
  author    = &#123;Lee, Yunsung and Lee, Hyeongmin&#125;,
  booktitle = &#123;European Conference on Computer Vision (ECCV)&#125;,
  year      = &#123;2026&#125;
&#125;</code></pre>
        <p id="copy-status" class="copy-status" role="status" aria-live="polite">Select the citation directly if copying is unavailable.</p>
      </div>

      <aside class="rights-note" aria-label="Rights and attribution">
        <h3>Rights are separated by material.</h3>
        <p>Website code is covered by this repository’s code license. Paper text and author figures are © 2026 Yunsung Lee and Hyeongmin Lee and are used on the authors’ project page. The ManLuML mascot is a separate brand asset. Affiliations are presented as text only; no institution logo files are shipped. Self-hosted Inter is distributed under the <a href={`${base}licenses/inter-OFL.txt`}>SIL Open Font License 1.1</a>.</p>
      </aside>
    </section>
  </main>

  <footer class="project-footer">
    <a class="footer-brand" href="https://manluml.github.io/"><img src={`${base}brand/manluml-mascot.svg`} width="42" height="42" alt="" /><span>Return to ManLuML</span></a>
    <p>ECCV 2026 · Yunsung Lee and Hyeongmin Lee</p>
  </footer>

  <script>
    const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-bibtex]');
    const citation = document.querySelector<HTMLElement>('#bibtex-text');
    const status = document.querySelector<HTMLElement>('#copy-status');

    copyButton?.addEventListener('click', async () => {
      if (!citation || !status) return;
      const text = citation.textContent?.trim() ?? '';
      try {
        if (!navigator.clipboard) throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(text);
        copyButton.textContent = 'Copied';
        status.textContent = 'BibTeX copied to the clipboard.';
      } catch {
        const selection = window.getSelection();
        const range = document.createRange();
        range.selectNodeContents(citation);
        selection?.removeAllRanges();
        selection?.addRange(range);
        copyButton.textContent = 'Citation selected';
        status.textContent = 'The BibTeX is selected. Copy it with your usual keyboard shortcut.';
      }
      window.setTimeout(() => { if (copyButton) copyButton.textContent = 'Copy BibTeX'; }, 2400);
    });
  </script>
</BaseLayout>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
    padding: 0.7rem max(1rem, calc((100vw - 1160px) / 2));
    border-bottom: 1px solid rgb(203 213 225 / 0.85);
    background: rgb(255 255 255 / 0.94);
    backdrop-filter: blur(14px);
  }
  .manluml-link { display: inline-flex; align-items: center; gap: 0.55rem; color: var(--ink); font-weight: 850; text-decoration: none; }
  .manluml-link img { width: 2.2rem; height: 2.2rem; }
  .site-header nav { display: flex; gap: 1.1rem; }
  .site-header nav a { color: var(--slate); font-size: 0.88rem; font-weight: 700; }
  .project-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.48fr) minmax(17rem, 0.52fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
    width: var(--content);
    margin: 0 auto;
    padding: clamp(3rem, 5vw, 4.5rem) 0 4rem;
  }
  .venue, .kicker {
    margin: 0 0 1rem;
    color: var(--navy);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2.8rem, 4.45vw, 4.65rem);
    font-weight: 660;
    letter-spacing: -0.048em;
    line-height: 1.01;
    overflow-wrap: anywhere;
  }
  .authors { margin: 2rem 0 0.5rem; font-size: clamp(1.1rem, 2vw, 1.35rem); overflow-wrap: anywhere; }
  .authors a { color: var(--ink); font-weight: 780; text-decoration-thickness: 0.08em; }
